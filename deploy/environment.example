NODE_ENV=production
PORT=80
HTTPS_PORT=443
PUBLIC_ORIGIN=https://west.cloud-ip.cc
APP_ORIGINS=https://west.cloud-ip.cc
DOMAIN_ONLY=1
ACCOUNTS_ENABLED=1
ACCOUNTS_DB=/var/lib/word-atlas/accounts.sqlite
ACCOUNT_QUOTA_BYTES=41943040
CLOUD_QUOTA_BYTES=536870912
ACME_ROOT=/var/lib/word-atlas/acme
TLS_CERT=/etc/word-atlas/tls/current/fullchain.pem
TLS_KEY=/etc/word-atlas/tls/current/privkey.pem
ADMIN_SOCKET=/run/word-atlas-admin/control.sock
