#!/usr/bin/env bash
set -euo pipefail
if [ "$(id -u)" -ne 0 ]; then
  echo '请在主机 root 交互终端设置管理员密码。' >&2
  exit 1
fi
if [ "$#" -gt 1 ]; then echo 'Usage: words-admin-setup [create|reset]' >&2; exit 1; fi
case "${1:-create}" in
  create) operation=create-admin ;;
  reset) operation=reset-admin ;;
  *) echo 'Usage: words-admin-setup [create|reset]' >&2; exit 1 ;;
esac
exec /opt/nodejs/node-v24.22.1-linux-x64/bin/node /data/word-atlas/scripts/admin.mjs "$operation" --username admin --db /var/lib/word-atlas/accounts.sqlite
